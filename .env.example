# ==============================================================================
# Clickfield AI Opportunity Radar - Environment Configuration
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Default for single-user mode: SQLite
DATABASE_URL=sqlite+aiosqlite:///./radar.db
# Team / Office Deployment mode (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://clickfield:radar_secret_pass@localhost:5432/clickfield_radar

# --- APPLICATION & ENVIRONMENT ---
APP_ENV=development # development | office_lan | production
SECRET_KEY=clickfield-secret-key-change-in-production-2026
SESSION_EXPIRY_HOURS=8

# --- OFFICE LAN & DEPLOYMENT ---
OFFICE_LAN_HOST=0.0.0.0
OFFICE_LAN_PORT=8000
PUBLIC_DOMAIN= # e.g. radar.clickfield.internal or yourdomain.com for automatic Caddy SSL

# --- MAILBOX CREDENTIALS (SMTP & IMAP) ---
# NOTE: MAIL_PASSWORD lives only in this file. It is NEVER stored in the database,
# NEVER logged, and NEVER returned from any API response.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
MAIL_USERNAME=zoya@clickfield.ai
MAIL_PASSWORD=your_office365_or_gmail_app_password
SEND_MODE=manual # "manual" (keeps Outlook mailto & "I sent it") or "smtp" (autonomous RFC-compliant dispatch)
AUTO_SEND_APPROVED_FOLLOWUPS=false # Default off; requires manual single-click per follow-up

# --- SENDER & COMPLIANCE IDENTITY ---
SENDER_FIRST_NAME=Zoya
SENDER_FULL_NAME=Zoya Patel
SENDER_ROLE=Technical Solutions & Engineering Lead
COMPANY_REGISTERED_ADDRESS=Clickfield Technologies Pvt. Ltd., Level 4, Prestige Tech Park, Marathahalli-Sarjapur Ring Rd, Bengaluru, KA 560103, India
COMPLIANCE_EMAIL=compliance@clickfield.ai

# --- CALENDAR & AUTOMATED BACKUPS ---
CALENDAR_DIGEST_EMAIL=false # Daily digest email at 08:30 IST (off by default)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- EXTERNAL INTEL & MAPS API ---
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LEADS_MONTHLY_BUDGET_USD=25.0
LOCAL_LEADS_SPEND_LIMIT_PER_RUN_USD=5.0
