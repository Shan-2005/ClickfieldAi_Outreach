# ==============================================================================
# ClickfieldAI Opportunity Radar — Environment Configuration
# ==============================================================================

# Database Connection (Default SQLite for instant local zero-setup; or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./radar.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clickfield_radar

# Optional LLM API Key (Anthropic Claude for extended semantic reasoning)
# If omitted, built-in intelligent heuristic extractors, classifiers, and scorers run locally
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ClickfieldAI Organization Settings
CLICKFIELD_COMPANY_NAME=ClickfieldAI
CLICKFIELD_WEBSITE=https://clickfield.ai
CLICKFIELD_COMPLIANCE_EMAIL=compliance@clickfield.ai

# Ingestion Politeness & Rate Limiting
USER_AGENT="ClickfieldRadarBot/1.0 (+https://clickfield.ai/bot-policy; compliance@clickfield.ai)"
RATE_LIMIT_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3

# Target Regions
PRIMARY_REGION=India
SECONDARY_REGIONS=Global,US,Europe,APAC
